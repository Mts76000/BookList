# Dedicated test environment — NEVER point this at a dev or prod database.
# tests/setup.ts refuses to run unless DATABASE_URL contains "test".

# --- App ---
NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Separate Postgres service (see docker-compose.yml -> `postgres-test`)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/booklist_test

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=test-secret-please-override-with-32-plus-chars
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# --- Analytics (Umami) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Email (Resend) ---
# Use a Resend test/sandbox key, or leave the API blocked out by mocks in tests
RESEND_API_KEY=re_test_key
CONTACT_EMAIL=test@example.com

# --- Anti-bot (Cloudflare Turnstile) ---
# Turnstile's official always-pass test keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Cron ---
CRON_SECRET=test-cron-secret
