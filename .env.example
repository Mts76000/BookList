# PostgreSQL — localement via docker-compose, ou fournie par Coolify en prod
DATABASE_URL="postgresql://booklist:booklist_password@localhost:5432/booklist"

# NextAuth — générez une clé forte avec : openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional : clé Google Books pour éviter les quotas/429
GOOGLE_BOOKS_API_KEY=""
