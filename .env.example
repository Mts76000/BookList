# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown in page titles/OG tags and in the admin signup notification email — set per project
NEXT_PUBLIC_APP_NAME=BookList
# Set to "true" only on the Coolify preview/staging environment, to force noindex (see README)
NEXT_PUBLIC_IS_PREVIEW=

# --- Database ---
# Local dev Postgres, started via `docker compose up -d`
DATABASE_URL=postgres://postgres:postgres@localhost:5436/booklist_dev

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Analytics (Umami) ---
# Website ID only — the Umami host domain is hardcoded in lib/umami.ts.
# Required for stats to actually track in production — left empty, the site loads fine but
# nothing is ever recorded (no error, no warning in the browser). Don't forget this one when
# setting up a new project's production env vars.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Google Books ---
# Optional: https://console.cloud.google.com/apis/credentials — raises the search quota.
GOOGLE_BOOKS_API_KEY=

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Used as both the "from" address and the recipient for admin notifications
CONTACT_EMAIL=contact@mathis-lamotte.fr

# --- Anti-bot (Cloudflare Turnstile) ---
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron ---
# Generate with: openssl rand -hex 32 — required by scheduled task endpoints (see README)
CRON_SECRET=

# --- Rate limiting (optional, prod) ---
# Leave empty in dev: rate limiting falls back to an in-memory limiter.
# Set both to enable Upstash Redis-backed rate limiting in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Buy Me a Coffee (optional) ---
# Leave empty to disable. Your page slug at buymeacoffee.com/<slug>.
NEXT_PUBLIC_BUYMEACOFFEE_SLUG=

# --- PWA install popup (optional) ---
# Set to "true" to show a dismissible "Install the app" popup once the browser reports the
# PWA as installable (Chromium only — iOS Safari has no such prompt). Off by default.
NEXT_PUBLIC_PWA_INSTALL_PROMPT_ENABLED=
