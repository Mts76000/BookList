// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  initialBooksRead Int    @default(0)
  resetToken    String?   @unique
  resetTokenExpiry DateTime?
  hasSeenOnboarding Boolean @default(false)
  isAnonymized  Boolean   @default(false)
  anonymizedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  books         Book[]
  comments      Comment[]
  readingActivities ReadingActivity[]
}

enum BookStatus {
  TO_READ
  READING
  FINISHED
}

model Book {
  id              String    @id @default(cuid())
  title           String
  author          String
  isbn            String?
  description     String?
  coverUrl        String?
  pageCount       Int?
  genre           String?
  publishedDate   String?
  userRating      Int?      // 1-5 stars
  userReadDate    DateTime?
  userStartDate   DateTime?
  userEndDate     DateTime?
  status          BookStatus @default(FINISHED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments        Comment[]
  readingSessions ReadingSession[]
  
  @@unique([userId, isbn])
  @@index([userId])
  @@index([userRating])
  @@index([status])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([bookId])
  @@index([userId])
}

model ReadingSession {
  id          String   @id @default(cuid())
  pagesRead   Int
  date        DateTime @default(now())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  
  @@index([bookId])
  @@index([date])
}

model ReadingActivity {
  id        String   @id @default(cuid())
  pagesRead Int      @default(0)
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date], name: "userId_date")
  @@index([userId])
  @@index([date])
}
